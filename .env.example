# Copy this file to ".env" and fill in your real Exotel values.

# --- Classic Voice v1 API (Click-to-Call / Connect Two Numbers) ---
EXOTEL_ACCOUNT_SID=your_account_sid
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_CALLER_ID=your_exophone_number
EXOTEL_REGION=Mumbai
EXOTEL_EXOTEL_DOMAIN=mumbai

# --- WebRTC / IP-PSTN WebSDK ---
EXOTEL_ICORE_BASE=https://integrationscore.mum1.exotel.com

# Customer entity, used to register/manage Apps. Your Client ID is the CustomerID.
EXOTEL_CLIENT_ID=your_webrtc_client_id
EXOTEL_CLIENT_SECRET=your_webrtc_client_secret

# App entity. Leave APP_ID/APP_SECRET blank — `npm run provision` creates the
# App and writes them back into .env. The WebSDK access token is an APP token.
EXOTEL_APP_NAME=webdialer
EXOTEL_APP_ID=
EXOTEL_APP_SECRET=

# The WebRTC agent. For the Exotel WebSDK the user id is the agent's EMAIL.
EXOTEL_WEBRTC_USER_ID=agent_email@example.com
EXOTEL_AGENT_NAME=Agent Name
# Optional fallback phone for the agent; leave blank for browser-only calling.
EXOTEL_AGENT_NUMBER=

# --- Server ---
PORT=3000

# --- Deployment (Railway) ---
# REQUIRED once this is reachable on a public URL: without it, anyone with the
# link can place calls billed to your Exotel account.
APP_PASSWORD=
# Random hex; keeps sessions valid across restarts.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Credential portal (optional) ---
# Supplied only as environment variables so the upstream call appears in no
# file in this repository and in no document that is published.
CRED_UPSTREAM_BASE=
CRED_UPSTREAM_PATH=
# Point this at a mounted volume in production, otherwise the record of which
# access codes have been spent is lost on every redeploy.
CRED_STORE_PATH=

# --- Zoho CRM (optional): lead card in the dialer + call logs in Zoho ---
# Paste the Client ID/Secret of a Zoho "Self Client", then run
#   npm run zoho:auth
# which fills in ZOHO_ACCOUNTS_URL and ZOHO_REFRESH_TOKEN for you.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=
ZOHO_REFRESH_TOKEN=
# Zoho user who owns the call logs. Defaults to EXOTEL_WEBRTC_USER_ID.
ZOHO_OWNER_EMAIL=
# false = don't log calls nobody answered.
ZOHO_LOG_UNANSWERED=true
# Country code tried when a 10-digit number is looked up in Zoho.
DEFAULT_COUNTRY_CODE=91
# For `npm run zoho:links`: the dialer's public https address, and the API
# name of the URL field that holds each record's "Call via Exotel" link.
DIALER_PUBLIC_URL=
ZOHO_LINK_FIELD=Call_via_Exotel

# --- Users ---
# The built-in admin signs in with ADMIN_EMAIL (default "admin") and
# APP_PASSWORD, and adds everyone else on /admin.html.
ADMIN_EMAIL=admin
ADMIN_NAME=
# Where added users are stored. On Railway, mount a volume (e.g. at /data) and
# set this to /data/users.json, or every redeploy forgets them.
USER_STORE_PATH=
